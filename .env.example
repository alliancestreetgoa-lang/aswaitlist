# Firebase web config for phone (SMS) verification.
#
# These values are NOT secret — every Firebase web config ships inside the
# client bundle and is readable in devtools. They live here so the project
# isn't hard-coded to one Firebase project. What actually protects the project
# is configured in the Firebase console: authorised domains, App Check, and the
# SMS region policy. See FIREBASE_SETUP.md.
#
# Project: alliance street waiting list (alliance-street-waiting-list)

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=


# ---------------------------------------------------------------------------
# SERVER-SIDE ONLY — Telagus (CRM) lead webhook
#
# Everything below this line IS secret, and the missing VITE_ prefix is what
# keeps it that way: Vite only exposes VITE_-prefixed variables to the client
# bundle, so these are readable by the Netlify function and by nothing else.
# Never rename one of these to VITE_* — that publishes it.
#
# Set them in Netlify → Site configuration → Environment variables (not in git;
# .env is gitignored). Locally they are only needed if you run the function,
# which means `npx netlify dev` rather than `npm run dev`.
# See netlify/functions/lead.js and TELAGUS_SETUP.md.
# ---------------------------------------------------------------------------

# The shared secret Telagus expects in the X-Webhook-Secret header.
TELAGUS_WEBHOOK_SECRET=

# Optional. Defaults to https://api.telagus.com/api/webhooks/11/lead — set this
# only to point at a different account, webhook id, or a staging endpoint.
TELAGUS_WEBHOOK_URL=

# Optional. Pipeline position new leads land in. Defaults to 'Leads'.
TELAGUS_LEAD_POSITION=

# Optional. The function verifies the visitor's Firebase ID token with Google
# before forwarding anything, and needs the project's API key to do it. Leave
# blank and it falls back to VITE_FIREBASE_API_KEY above, which is the same
# key and is already set — this exists only for the case where you'd rather
# keep the two uses on separate, individually restricted keys.
FIREBASE_API_KEY=
